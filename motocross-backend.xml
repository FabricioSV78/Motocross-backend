class TrackAvailabilityResponse(BaseModel):
    """Response body para create/get availability."""
    id: int
    track_id: int
    date: date
    startTime: str
    endTime: str
    capacity: int
    rentalType: str
    pilotCategory: str = "BOTH"

    model_config = {"from_attributes": True}

    @classmethod
    def from_orm_slot(cls, slot) -> "TrackAvailabilityResponse":
        return cls(
            id=slot.id,
